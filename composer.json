{
    "name": "silvershop-suite/cms-ui",
    "description": "Neutral, structural CMS-form layout primitives for the SilverShop suite: a responsive 12-column GridLayoutField (with an opt-in full-page-width mode and an fr-template escape hatch) and a native-blend PanelField card, so a ModelAdmin edit form can lay panels out in a grid instead of flat tab sprawl. Shop-agnostic, CSS-only, blends with the stock Silverstripe 6 admin (and its dark mode).",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "cms", "admin", "forms", "grid", "layout", "panel", "ux"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-cms-ui/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/admin": "^3.0"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        },
        "expose": [
            "client"
        ]
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\CmsUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\CmsUi\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
