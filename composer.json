{
    "name": "silvershop-suite/cms-ui",
    "description": "Neutral CMS-form UI primitives for the Silverstripe 6 admin, built for the SilverShop suite but shop-agnostic: a responsive 12-column GridLayoutField, native-blend PanelField cards (icon, count, live header actions, flush or scrollable body), an always-visible GridFieldFilterForm, status badges and row tints for any GridField, and the Lucide icon webfont. Blends with the stock admin and its dark mode.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "cms",
        "admin",
        "forms",
        "grid",
        "layout",
        "panel",
        "gridfield",
        "filter",
        "badges",
        "icons",
        "ux"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Remy Vaartjes",
            "email": "remy@xd.nl",
            "role": "Lead developer"
        },
        {
            "name": "SilverShop-Suite Contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/admin": "^3.0"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "expose": [
            "client"
        ]
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\CmsUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\CmsUi\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
